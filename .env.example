NODE_ENV=development
APP_URL=http://localhost:5180
API_URL=http://localhost:4010
PORT=4010
COMMERCE_API_PORT=4010
VITE_PUBLIC_SITE_URL=http://localhost:5180
DATABASE_URL=mysql://varahi:change_me@localhost:3310/sri_varahi_traders
MYSQL_USER=varahi
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=sri_varahi_traders
USE_DATABASE=true
REDIS_URL=redis://localhost:6390
JWT_SECRET=replace-with-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-64-random-characters
INTEGRATION_ENCRYPTION_KEY=base64-encoded-32-byte-key
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Production: list each exact HTTPS storefront origin; wildcards are rejected.
# Comma-separated proxy IPs/CIDRs. Leave empty unless the API is reachable
# only through those proxies; trusted proxies must replace forwarded headers.
TRUST_PROXY=
VITE_COMMERCE_API_URL=http://localhost:4010
# Supply this client's Firebase settings together; no other client defaults are used.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your-public-web-api-key
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_APP_ID=your-public-web-app-id
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4010/uploads
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=
DELHIVERY_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=TEST

# The client's verified Google account; leave blank until provided.
STORE_ADMIN_EMAIL=
