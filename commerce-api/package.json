{
  "name": "sri-varahi-traders-commerce-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --import tsx src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/src/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:smoke": "node --env-file-if-exists=../.env --import tsx scripts/db-smoke.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "seed": "node --env-file-if-exists=../.env --import tsx prisma/seed.ts",
    "seed:compiled": "node dist/prisma/seed.js",
    "admin:create": "node --env-file-if-exists=../.env --import tsx scripts/create-admin.ts",
    "notifications:process": "tsx scripts/process-notifications.ts",
    "db:deploy": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js migrate deploy",
    "test:db": "node --env-file-if-exists=../.env --import tsx scripts/test-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "prisma": "^6.16.2",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
