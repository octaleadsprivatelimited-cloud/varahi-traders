generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
  ORDER_MANAGER
  INVENTORY_MANAGER
  SUPPORT
  FINANCE
  MARKETING
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
  REFUND_PENDING
  REFUNDED
  FAILED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ProviderKind {
  PAYMENT
  SHIPPING
  EMAIL
  SMS
  WHATSAPP
  STORAGE
  ANALYTICS
  AUTH
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model User {
  id                        String               @id @default(uuid()) @db.Char(36)
  email                     String               @unique
  mobile                    String?              @unique
  totpSecret                Bytes?
  totpEnabled               Boolean              @default(false)
  name                      String
  role                      UserRole             @default(CUSTOMER)
  verifiedAt                DateTime?
  disabledAt                DateTime?
  authVersion               Int                  @default(0)
  tags                      Json                 @default("[]")
  note                      String?              @db.Text
  marketingConsent          Boolean              @default(false)
  marketingConsentUpdatedAt DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  addresses                 Address[]
  orders                    Order[]
  reviews                   Review[]
  auditLogs                 AuditLog[]
  sessions                  Session[]
  carts                     Cart[]
  wishlistItems             WishlistItem[]
  couponUsages              CouponUsage[]
  returnRequests            ReturnRequest[]
  notifications             Notification[]
  supportTickets            SupportTicket[]
  supportMessages           SupportMessage[]
  roleAssignments           UserRoleAssignment[]
  authIdentities            AuthIdentity[]

  @@index([role, disabledAt, createdAt])
  @@index([role, marketingConsent, createdAt])
}

model AuthIdentity {
  id                  String   @id @default(uuid()) @db.Char(36)
  userId              String   @db.Char(36)
  provider            String
  subject             String
  audience            String
  email               String?
  lastAuthenticatedAt DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([userId])
}

model Session {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Role {
  id          String               @id @default(uuid()) @db.Char(36)
  name        String               @unique
  description String?              @db.Text
  assignments UserRoleAssignment[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  key         String           @unique
  description String?          @db.Text
  roles       RolePermission[]
}

model UserRoleAssignment {
  userId String @db.Char(36)
  roleId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Address {
  id         String  @id @default(uuid()) @db.Char(36)
  userId     String  @db.Char(36)
  label      String
  line1      String
  line2      String?
  phone      String? @db.VarChar(16)
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id       String     @id @default(uuid()) @db.Char(36)
  name     String
  slug     String     @unique
  parentId String?    @db.Char(36)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id       String    @id @default(uuid()) @db.Char(36)
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id             String           @id @default(uuid()) @db.Char(36)
  name           String
  slug           String           @unique
  description    String           @db.Text
  status         String           @default("DRAFT")
  categoryId     String           @db.Char(36)
  brandId        String?          @db.Char(36)
  hsnCode        String?
  taxRate        Decimal          @default(18) @db.Decimal(5, 2)
  specifications Json             @default("{}")
  seoTitle       String?
  seoDescription String?
  metadata       Json?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  category       Category         @relation(fields: [categoryId], references: [id])
  brand          Brand?           @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  media          ProductMedia[]
  reviews        Review[]
  wishlistItems  WishlistItem[]

  @@index([categoryId, status])
  @@index([name])
}

model ProductVariant {
  id          String         @id @default(uuid()) @db.Char(36)
  productId   String         @db.Char(36)
  sku         String         @unique
  title       String
  price       Decimal        @db.Decimal(12, 2)
  mrp         Decimal        @db.Decimal(12, 2)
  weightGrams Int
  attributes  Json
  active      Boolean        @default(true)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory?
  orderItems  OrderItem[]
  cartItems   CartItem[]
  media       ProductMedia[]
}

model ProductMedia {
  id        String          @id @default(uuid()) @db.Char(36)
  productId String          @db.Char(36)
  variantId String?         @db.Char(36)
  url       String          @db.Text
  alt       String
  type      String          @default("IMAGE")
  position  Int             @default(0)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([variantId])
}

model Inventory {
  id         String              @id @default(uuid()) @db.Char(36)
  variantId  String              @unique @db.Char(36)
  onHand     Int                 @default(0)
  reserved   Int                 @default(0)
  lowStockAt Int                 @default(5)
  version    Int                 @default(0)
  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements  InventoryMovement[]
}

model InventoryMovement {
  id             String    @id @default(uuid()) @db.Char(36)
  inventoryId    String    @db.Char(36)
  quantity       Int
  reason         String
  referenceId    String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  inventory      Inventory @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId, createdAt])
}

model Cart {
  id         String     @id @default(uuid()) @db.Char(36)
  userId     String?    @db.Char(36)
  guestToken String?    @unique
  currency   String     @default("INR")
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@index([userId, updatedAt])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Char(36)
  cartId    String         @db.Char(36)
  variantId String         @db.Char(36)
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  productId String   @db.Char(36)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Coupon {
  id              String        @id @default(uuid()) @db.Char(36)
  code            String        @unique
  type            CouponType
  value           Decimal       @db.Decimal(12, 2)
  minimumSpend    Decimal       @default(0) @db.Decimal(12, 2)
  maximumDiscount Decimal?      @db.Decimal(12, 2)
  usageLimit      Int?
  perUserLimit    Int           @default(1)
  appliesTo       String        @default("ALL_PRODUCTS") @db.VarChar(24)
  productIds      Json?
  startsAt        DateTime
  endsAt          DateTime
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  orders          Order[]
  usages          CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(uuid()) @db.Char(36)
  couponId String   @db.Char(36)
  userId   String   @db.Char(36)
  orderId  String   @unique @db.Char(36)
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
}

model Order {
  id              String          @id @default(uuid()) @db.Char(36)
  number          String          @unique
  userId          String?         @db.Char(36)
  couponId        String?         @db.Char(36)
  status          OrderStatus     @default(PENDING)
  currency        String          @default("INR")
  subtotal        Decimal         @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  tax             Decimal         @db.Decimal(12, 2)
  shipping        Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  addressSnapshot Json
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon          Coupon?         @relation(fields: [couponId], references: [id])
  couponUsage     CouponUsage?
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]
  history         OrderHistory[]
  returns         ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String         @id @default(uuid()) @db.Char(36)
  orderId     String         @db.Char(36)
  variantId   String         @db.Char(36)
  name        String
  sku         String
  attributes  Json
  unitPrice   Decimal        @db.Decimal(12, 2)
  quantity    Int
  tax         Decimal        @db.Decimal(12, 2)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]
}

model OrderHistory {
  id         String       @id @default(uuid()) @db.Char(36)
  orderId    String       @db.Char(36)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Char(36)
  source     String
  metadata   Json?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id                   String               @id @default(uuid()) @db.Char(36)
  orderId              String               @db.Char(36)
  provider             String
  externalId           String?
  gatewayTransactionId String?
  status               PaymentStatus        @default(CREATED)
  amount               Decimal              @db.Decimal(12, 2)
  currency             String
  idempotencyKey       String               @unique
  verifiedAt           DateTime?
  createdAt            DateTime             @default(now())
  order                Order                @relation(fields: [orderId], references: [id])
  transactions         PaymentTransaction[]
  refunds              Refund[]
}

model PaymentTransaction {
  id              String   @id @default(uuid()) @db.Char(36)
  paymentId       String   @db.Char(36)
  providerEventId String   @unique
  kind            String
  amount          Decimal  @db.Decimal(12, 2)
  safePayload     Json
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id])
}

model Refund {
  id              String         @id @default(uuid()) @db.Char(36)
  paymentId       String         @db.Char(36)
  returnRequestId String?        @unique @db.Char(36)
  externalId      String?        @unique
  amount          Decimal        @db.Decimal(12, 2)
  status          String
  reason          String?
  idempotencyKey  String         @unique
  createdAt       DateTime       @default(now())
  payment         Payment        @relation(fields: [paymentId], references: [id])
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])
}

model ReturnRequest {
  id        String       @id @default(uuid()) @db.Char(36)
  orderId   String       @db.Char(36)
  userId    String?      @db.Char(36)
  status    String       @default("REQUESTED")
  reason    String
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  order     Order        @relation(fields: [orderId], references: [id])
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     ReturnItem[]
  refund    Refund?

  @@index([orderId, status])
  @@index([status, createdAt])
}

model ReturnItem {
  id              String        @id @default(uuid()) @db.Char(36)
  returnRequestId String        @db.Char(36)
  orderItemId     String        @db.Char(36)
  quantity        Int
  condition       String?
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([returnRequestId, orderItemId])
}

model Shipment {
  id             String          @id @default(uuid()) @db.Char(36)
  orderId        String          @db.Char(36)
  provider       String
  externalId     String?
  awb            String?         @unique
  courier        String?
  trackingUrl    String?         @db.Text
  status         String
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  order          Order           @relation(fields: [orderId], references: [id])
  events         TrackingEvent[]
}

model TrackingEvent {
  id              String   @id @default(uuid()) @db.Char(36)
  shipmentId      String   @db.Char(36)
  providerEventId String   @unique
  status          String
  location        String?
  occurredAt      DateTime
  shipment        Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, occurredAt])
}

model Review {
  id        String   @id @default(uuid()) @db.Char(36)
  productId String   @db.Char(36)
  userId    String   @db.Char(36)
  rating    Int
  title     String?
  body      String   @db.Text
  verified  Boolean  @default(false)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id                String    @id @default(uuid()) @db.Char(36)
  userId            String?   @db.Char(36)
  channel           String
  template          String
  destination       String
  status            String    @default("QUEUED")
  providerMessageId String?
  firstAttemptAt    DateTime?
  payload           Json
  error             String?   @db.Text
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lockedAt          DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
}

model MobileOtpChallenge {
  mobile    String   @id @db.VarChar(16)
  codeHash  String   @db.Char(64)
  attempts  Int      @default(0)
  expiresAt DateTime
  resendAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model SupportTicket {
  id        String           @id @default(uuid()) @db.Char(36)
  number    String           @unique
  userId    String?          @db.Char(36)
  subject   String
  status    String           @default("OPEN")
  priority  String           @default("NORMAL")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([status, updatedAt])
}

model SupportMessage {
  id        String        @id @default(uuid()) @db.Char(36)
  ticketId  String        @db.Char(36)
  authorId  String?       @db.Char(36)
  body      String        @db.Text
  internal  Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model IntegrationConfig {
  id                   String       @id
  kind                 ProviderKind
  provider             String
  enabled              Boolean      @default(false)
  priority             Int          @default(100)
  environment          String       @default("TEST")
  encryptedCredentials Bytes        @db.LongBlob
  publicConfig         Json
  updatedAt            DateTime     @updatedAt

  @@unique([kind, provider, environment])
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Char(36)
  provider       String
  externalId     String
  signatureValid Boolean
  status         String
  payloadHash    String
  safePayload    Json?
  error          String?   @db.Text
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@unique([provider, externalId])
}

model Setting {
  key       String   @id
  value     Json
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @db.Char(36)
  action     String
  resource   String
  resourceId String?
  ip         String?
  userAgent  String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId, createdAt])
}
