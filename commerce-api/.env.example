NODE_ENV=development
PORT=4010
DATABASE_URL=mysql://varahi:change_me@localhost:3310/sri_varahi_traders
MYSQL_USER=varahi
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=sri_varahi_traders
USE_DATABASE=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-a-32-character-key-from-a-secret-manager
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Production requires explicit HTTPS CORS origins, USE_DATABASE=true and an
# HTTPS PUBLIC_UPLOAD_BASE_URL. Never use wildcard origins for tenant stores.
TRUST_PROXY=
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4010/uploads
# Supply this client's Firebase settings together; no other client defaults are used.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your-public-web-api-key
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_APP_ID=your-public-web-app-id
# Other providers can be configured in Admin -> Integrations.
# RAZORPAY_WEBHOOK_SECRET=
# SHIPROCKET_WEBHOOK_SECRET=

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=TEST

# The client's verified Google account; leave blank until provided.
STORE_ADMIN_EMAIL=
